# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# Node
node_modules/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / dev artifacts
api.pid
web.pid
*.pid
*.cookies
cookies.txt
trash/

# Stray scratch files from in-shell debugging + ad-hoc JSON reports.
# These come from `> tmp.XYZ` redirects and one-shot `git ls-tree` style
# dumps and have no business landing in the recruiter-facing public repo.
tmp.*
/scripts/_*.tmp
/scripts/_gh-tree-*.json
/scripts/_pids.txt

# One-time backup of the inner apps/web git state captured before flattening
# the apps/web submodule on 2026-07-27. Safe to keep locally or delete; never commit.
.git-backup-apps-web/

# Local env overrides (never commit)
.env
.env.*
!.env.example

# Runtime logs (start-dev.sh writes here)
/logs/

# Windows: literal "nul" file from accidental `> nul` redirects
nul

# IDEs
.idea/
.vscode/
*.swp

# SQLite / local data
*.db
*.sqlite3

# Alembic local config
alembic.ini.bak

# OS
.DS_Store
Thumbs.db

# Internal dev tooling: AI agent / design plugin state. These directories
# hold personal assistant configuration, skills, hooks, and verdict notes
# that are not part of the portfolio codebase and should never be pushed
# to a public recruiter-facing repository. All patterns are anchored
# with / to match the existing /logs/ style so they only match top-level
# entries and never accidentally sweep up a nested apps/* path of the
# same name.
/.tmp/
/.agents/
/.claude/
/.codex/
/.impeccable/

# Browser profile used by Playwright / local dev. May contain saved
# logins, account web data, and site engagement history. Never push.
# Remediation 2026-07-30: amend e88112d scrubbed 242 leaked .chrome-profile/*; do not remove.
/.chrome-profile/

# Playwright + community-skills artifacts; auto-generated by
# `npx playwright test` and skills-install. /skills-lock.json tracks
# personal assistant tooling.
/playwright-report/
/test-results/
/blob-report/
/skills-lock.json

# Vercel CLI cache. We deploy to Vercel so this WILL be created locally
# the moment the user runs `vercel` or `vercel pull` from the project.
/.vercel/

# Python tooling caches + coverage output. The .coverage pattern is
# intentionally unanchored so apps/api/.coverage is caught when
# pytest-cov writes a per-app coverage file; the .pytest_cache,
# .mypy_cache, and .ruff_cache lines are anchored because those
# bytecode caches belong at the project root in this single-pyproject
# layout.
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
.coverage

# Internal-only hook configs (kept under .github/ layouts so the directory
# is preserved but the file contents stay private).
/.github/hooks/

# Orphaned singular leaks from the c6d5072 audit push. Unanchored so
# any nested stray copy under apps/*/static/* is also caught, not
# just the top-level one.
huggingface_tasks.png
