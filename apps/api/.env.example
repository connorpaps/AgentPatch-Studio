# API security
AGENTPATCH_API_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentpatch

# Redis / Celery
# Local dev: any redis:// or rediss:// URL works.
# Production (Render free tier + Upstash free tier): use the rediss://
# (Redis protocol, NOT the REST API URL) from Upstash's "Connect ->
# Redis protocol" panel. The /api/v1/health endpoint probes this URL on
# every request and will report status=degraded if it's missing or
# stale.
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agentpatch-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# LLM provider: openai or mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
